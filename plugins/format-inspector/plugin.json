{
  "id": "format-inspector",
  "name": "Format Inspector",
  "version": "1.0.1",
  "api_version": 2,
  "type": "extension",
  "command": "format-inspector.exe",
  "contributes": {
    "commands": [
      "render"
    ],
    "clipboard": {
      "preview": {
        "command": "render",
        "content_types": [
          "text",
          "image",
          "file",
          "custom"
        ],
        "formats": [
          "*"
        ],
        "modes": [
          "formats"
        ]
      }
    }
  },
  "icon": "icon.png",
  "name_i18n": {
    "zh": "剪贴板格式检查",
    "zh_TW": "剪貼簿格式檢查"
  }
}
