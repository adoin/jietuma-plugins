{
  "id": "secret-filter",
  "name": "Sensitive Content Protection",
  "name_i18n": {
    "zh": "敏感内容保护",
    "zh_TW": "敏感內容保護",
    "ja": "機密情報の保護",
    "ko": "민감 정보 보호"
  },
  "version": "1.0.1",
  "api_version": 2,
  "type": "extension",
  "command": "secret-filter.exe",
  "contributes": {
    "hooks": [
      {
        "event": "clipboard.before_capture",
        "content_types": [
          "text"
        ]
      }
    ]
  },
  "icon": "icon.png",
  "description": "Filter clipboard capture using sensitive-content rules.",
  "description_i18n": {
    "zh": "通过敏感内容规则过滤剪贴板采集。",
    "zh_TW": "透過敏感內容規則篩選剪貼簿擷取。"
  }
}
