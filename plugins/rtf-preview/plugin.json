{
  "id": "rtf-preview",
  "name": "RTF Preview",
  "version": "1.0.1",
  "api_version": 2,
  "type": "extension",
  "command": "rtf-preview.exe",
  "contributes": {
    "commands": [
      "render"
    ],
    "clipboard": {
      "preview": {
        "command": "render",
        "content_types": [
          "text",
          "custom"
        ],
        "formats": [
          "Rich Text Format"
        ],
        "priority": 100
      }
    }
  },
  "icon": "icon.png",
  "name_i18n": {
    "zh": "富文本预览",
    "zh_TW": "富文字預覽"
  },
  "description": "Preview rich text saved on the clipboard.",
  "description_i18n": {
    "zh": "预览剪贴板中的 RTF 富文本。",
    "zh_TW": "預覽剪貼簿中的 RTF 豐富文字。"
  }
}
