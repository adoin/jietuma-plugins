{
  "id": "markdown-preview",
  "name": "Markdown Preview",
  "version": "1.0.1",
  "api_version": 2,
  "type": "extension",
  "command": "markdown-preview.exe",
  "contributes": {
    "commands": [
      "render"
    ],
    "clipboard": {
      "preview": {
        "command": "render",
        "content_types": [
          "file"
        ]
      }
    }
  },
  "icon": "icon.png",
  "name_i18n": {
    "zh": "Markdown 预览",
    "zh_TW": "Markdown 預覽"
  }
}
