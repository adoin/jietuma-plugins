{
  "id": "json-preview",
  "name": "JSON Preview",
  "version": "1.0.1",
  "api_version": 2,
  "type": "extension",
  "command": "json-preview.exe",
  "contributes": {
    "commands": [
      "render"
    ],
    "clipboard": {
      "preview": {
        "command": "render",
        "content_types": [
          "text"
        ]
      }
    }
  },
  "icon": "icon.png",
  "name_i18n": {
    "zh": "JSON 预览",
    "zh_TW": "JSON 預覽"
  }
}
